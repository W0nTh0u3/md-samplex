# Supabase dashboard > Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Set to your deployed canonical HTTPS origin (localhost for development).
APP_ORIGIN=http://localhost:3000
# Local preview only: file-backed anonymous accounts; no Google or device sync.
# Development defaults to preview when Supabase is absent. Production fails closed
# unless explicitly enabled. Disable this when configuring Supabase.
PLE_DEMO_MODE=false
